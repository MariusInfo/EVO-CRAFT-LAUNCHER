<Window x:Class="Updater_EvoCraft.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EVO CRAFT UPDATER" Height="220" Width="450" 
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" Topmost="True">

    <Border CornerRadius="15" Background="#121212" BorderBrush="#43b581" BorderThickness="2">
        <Grid Margin="25">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="EVO CRAFT" FontSize="28" FontWeight="Black" Foreground="#43b581" HorizontalAlignment="Center">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#43b581" BlurRadius="15" ShadowDepth="0"/>
                    </TextBlock.Effect>
                </TextBlock>

                <TextBlock x:Name="lblStatus" Text="Se verifică fișierele..." Foreground="White" HorizontalAlignment="Center" Margin="0,15,0,5" FontSize="14"/>

                <Grid Margin="0,10,0,0">
                    <ProgressBar x:Name="pbUpdate" Height="12" Background="#1AFFFFFF" Foreground="#43b581" BorderThickness="0" Minimum="0" Maximum="100"/>
                    <Border CornerRadius="6" Background="Transparent" BorderBrush="#33FFFFFF" BorderThickness="1"/>
                </Grid>

                <TextBlock x:Name="lblPercentage" Text="0%" Foreground="#888888" FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>