<Window x:Class="EVO_CRAFT_LAUNCHER.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="EVO CRAFT" Height="640" Width="1040" 
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        MouseDown="Window_MouseDown" SnapsToDevicePixels="True">

    <Window.Resources>
        <Geometry x:Key="IconTikTok">M12.525.02c1.31.1 2.47.75 3.28 1.7.53-.11 1.08-.16 1.64-.15V4.88c-1.06.65-2.27.97-3.5 1-.01 4.77.01 9.54-.01 14.31-.08 3.51-2.9 6.25-6.4 6.38-3.41.25-6.52-1.92-7.46-5.18C.11 16.63 1.67 12.9 5.01 11.95v3.42c-1.12.35-1.91 1.34-1.98 2.52-.10 1.71 1.25 3.2 2.96 3.32 1.78.19 3.42-1.07 3.65-2.85.06-4.52.02-9.04.03-13.56.02-1.63.78-3.1 2.06-4.04.55-.42 1.2-.68 1.81-.74z</Geometry>
        <Geometry x:Key="IconYouTube">M23.5 6.2c-.3-1.1-1.1-1.9-2.2-2.2C19.4 3.5 12 3.5 12 3.5s-7.4 0-9.3.5c-1.1.3-1.9 1.1-2.2 2.2C0 8.1 0 12 0 12s0 3.9.5 5.8c.3 1.1 1.1 1.9 2.2 2.2 1.9.5 9.3.5 9.3.5s7.4 0 9.3-.5c1.1-.3 1.9-1.1 2.2-2.2.5-1.9.5-5.8.5-5.8s0-3.9-.5-5.8zM9.5 15.5V8.5l6.5 3.5-6.5 3.5z</Geometry>
        <Geometry x:Key="IconDiscord">M18.9 4.3C17.5 3.6 15.9 3.2 14.3 3c-.2.4-.4.8-.6 1.2-1.7-.3-3.5-.3-5.2 0-.2-.4-.4-.8-.6-1.2-1.7.2-3.2.6-4.7 1.3C.5 8.3-.3 12.3.1 16.2c2 1.5 3.9 2.4 5.8 3 .5-.6.9-1.3 1.2-2-1-.4-1.9-.8-2.8-1.4.2-.2.5-.3.7-.5 3.8 1.8 8 1.8 11.8 0 .2.2.5.3.7.5-.9.6-1.8 1-2.8 1.4.3.7.7 1.4 1.2 2 1.9-.6 3.8-1.5 5.8-3 .5-4.5-.7-8.4-3.1-11.9zM8.5 14c-1.1 0-2-1-2-2.2s.9-2.2 2-2.2 2 1 2 2.2-.9 2.2-2 2.2zm7 0c-1.1 0-2-1-2-2.2s.9-2.2 2-2.2 2 1 2 2.2-.9 2.2-2 2.2z</Geometry>

        <Storyboard x:Key="RamWarningAnim">
            <ColorAnimation Storyboard.TargetName="MainContainer" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="Red" Duration="0:0:0.4" AutoReverse="True" RepeatBehavior="2x"/>
            <ColorAnimation Storyboard.TargetName="brdNewsPopOut" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="Red" Duration="0:0:0.4" AutoReverse="True" RepeatBehavior="2x"/>
            <ColorAnimation Storyboard.TargetName="brdRegister" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="Red" Duration="0:0:0.4" AutoReverse="True" RepeatBehavior="2x"/>
        </Storyboard>

        <Style x:Key="TabButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="12" Margin="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LaunchButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#43b581"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="20">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="CornerRadius" Value="26"/>
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="20" Color="#43b581" Opacity="0.8" ShadowDepth="0"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#2f3136"/>
                                <Setter TargetName="border" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SocialButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="25,5"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#33FFFFFF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="30">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="15" Color="White" Opacity="0.7" ShadowDepth="0"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Border x:Name="MainContainer" CornerRadius="25" Background="#121212" BorderBrush="#43b581" BorderThickness="1.5">
            <Grid>
                <Grid.OpacityMask>
                    <VisualBrush>
                        <VisualBrush.Visual>
                            <Border Background="Black" CornerRadius="25" Width="{Binding ActualWidth, ElementName=MainContainer}" Height="{Binding ActualHeight, ElementName=MainContainer}"/>
                        </VisualBrush.Visual>
                    </VisualBrush>
                </Grid.OpacityMask>

                <MediaElement x:Name="bgVideo" Source="background.mp4" LoadedBehavior="Manual" Stretch="UniformToFill" IsMuted="True" MediaEnded="bgVideo_MediaEnded" Loaded="bgVideo_Loaded"/>
                <Rectangle Fill="Black" Opacity="0.55"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Panel.ZIndex="100">
                    <Button Width="45" Height="32" Content="—" Click="btnMinimize_Click" Background="Transparent" Foreground="White" BorderThickness="0"/>
                    <Button Width="45" Height="32" Content="✕" Click="btnClose_Click" Background="Transparent" Foreground="White" BorderThickness="0"/>
                </StackPanel>

                <Grid Margin="40">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <StackPanel HorizontalAlignment="Left">
                            <TextBlock Text="EVO CRAFT" FontSize="40" FontWeight="Black" Foreground="White"/>
                            <TextBlock Text="LAUNCHER OFICIAL" FontSize="12" Foreground="#43b581" FontWeight="Bold"/>
                        </StackPanel>
                        <Border HorizontalAlignment="Right" Background="#AA000000" CornerRadius="12" Padding="15,8" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="elServerStatus" Width="10" Height="10" Fill="Gray" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="lblServerInfo" Text="VERIFICARE..." Foreground="White" VerticalAlignment="Center" FontWeight="Bold" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                <Button x:Name="btnRefreshServer" Content="↻" Click="btnRefreshServer_Click" Background="Transparent" Foreground="White" BorderThickness="0" Margin="10,0,0,0" Cursor="Hand" FontSize="18"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Width="220" Margin="0,20,0,0" Background="#99000000" CornerRadius="15" Padding="15" BorderBrush="#33FFFFFF" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="🏆 TOP PLAYTIME" Foreground="#43b581" FontWeight="Black" FontSize="14" Margin="0,0,0,10" HorizontalAlignment="Center"/>
                                <ItemsControl x:Name="lstTopPlayed">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Username}" Foreground="White" FontSize="12" FontWeight="Bold"/>
                                                <TextBlock Grid.Column="1" Text="{Binding DisplayTime}" Foreground="#43b581" FontSize="11" Opacity="0.8" Margin="5,0,0,0"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="400">
                            <Border Background="#CC121212" CornerRadius="20" Padding="30" BorderBrush="#22FFFFFF" BorderThickness="1">
                                <StackPanel>
                                    <Border Background="#1AFFFFFF" CornerRadius="15" Padding="4" Margin="0,0,0,25">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="btnTabCracked" Content="CRACKED" Click="btnTabCracked_Click" Style="{StaticResource TabButtonStyle}" Height="35" Grid.Column="0"/>
                                            <Button x:Name="btnTabPremium" Content="PREMIUM" Click="btnTabPremium_Click" Style="{StaticResource TabButtonStyle}" Height="35" Grid.Column="1"/>
                                        </Grid>
                                    </Border>

                                    <StackPanel x:Name="pnlUsernameInput">
                                        <TextBlock Text="NUME UTILIZATOR" Foreground="Gray" FontSize="10" FontWeight="Bold" Margin="0,0,0,8"/>
                                        <TextBox x:Name="txtUsername" Height="40" Background="#44000000" Foreground="White" VerticalContentAlignment="Center" Padding="12,0" FontSize="14" BorderBrush="#33FFFFFF" TextChanged="txtUsername_TextChanged" Margin="0,0,0,10"/>
                                        <TextBlock Text="PAROLĂ" Foreground="Gray" FontSize="10" FontWeight="Bold" Margin="0,0,0,8"/>
                                        <PasswordBox x:Name="txtPassword" Height="40" Background="#44000000" Foreground="White" VerticalContentAlignment="Center" Padding="12,0" FontSize="14" BorderBrush="#33FFFFFF"/>
                                        <Button Content="Nu ai cont? Înregistrează-te aici" Click="btnOpenRegister_Click" Background="Transparent" Foreground="Gray" BorderThickness="0" FontSize="11" Cursor="Hand" Margin="0,5,0,0"/>
                                    </StackPanel>

                                    <StackPanel x:Name="pnlDbLoggedInMsg" Visibility="Collapsed" Height="100" VerticalAlignment="Center">
                                        <TextBlock x:Name="lblDbLoggedUser" Text="Ești logat ca: -" Foreground="White" HorizontalAlignment="Center" FontWeight="Bold" FontSize="14" Margin="0,10"/>
                                        <TextBlock Text="Sesiune Activă (Bază de Date)" Foreground="#43b581" HorizontalAlignment="Center" FontSize="10"/>
                                        <Button Content="Schimbă contul" Click="btnLogout_Click" Background="Transparent" Foreground="Gray" BorderThickness="0" FontSize="11" Cursor="Hand" Margin="0,10,0,0"/>
                                    </StackPanel>

                                    <StackPanel x:Name="pnlPremiumMsg" Visibility="Collapsed" Height="100" VerticalAlignment="Center">
                                        <TextBlock Text="CONT PROTEJAT (PREMIUM)" Foreground="#43b581" HorizontalAlignment="Center" FontWeight="Bold" FontSize="14" Margin="0,5"/>
                                        <TextBlock Text="Autentificare prin Microsoft" Foreground="Gray" HorizontalAlignment="Center" FontSize="10"/>
                                        <Button Content="Deconectare Microsoft" Click="btnLogout_Click" Background="Transparent" Foreground="Gray" BorderThickness="0" FontSize="11" Cursor="Hand" Margin="0,15,0,0"/>
                                    </StackPanel>

                                    <Button x:Name="btnLaunch" Content="JOACĂ" Click="btnLaunch_Click" Height="65" Margin="0,15,0,0" Style="{StaticResource LaunchButtonStyle}"/>

                                    <Grid Margin="0,20,0,0">
                                        <StackPanel>
                                            <TextBlock x:Name="lblProgressDetails" Text="" Foreground="#43b581" FontSize="10" HorizontalAlignment="Right" Margin="0,0,0,5"/>
                                            <ProgressBar x:Name="pbProgress" Height="8" Foreground="#43b581" Background="#1AFFFFFF" BorderThickness="0" Minimum="0" Maximum="100"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock x:Name="lblStatus" Text="Gata de pornire" Foreground="Gray" HorizontalAlignment="Center" Margin="0,10,0,0" FontSize="12"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <Border HorizontalAlignment="Right" VerticalAlignment="Center" Width="200" Background="#CC121212" CornerRadius="20" Padding="15" BorderBrush="#22FFFFFF" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="🎮 MOD DE JOC" Foreground="#43b581" FontWeight="Black" FontSize="13" Margin="0,0,0,15" HorizontalAlignment="Center"/>

                                <Button x:Name="btnModeSurvival" Content="SURVIVAL" Click="btnModeSurvival_Click" Style="{StaticResource TabButtonStyle}" Height="38" Margin="0,5"/>
                                <Button x:Name="btnModeSkyblock" Content="SKYBLOCK" Click="btnModeSkyblock_Click" Style="{StaticResource TabButtonStyle}" Height="38" Margin="0,5"/>
                                <Button x:Name="btnModeCreative" Content="CREATIVE" Click="btnModeCreative_Click" Style="{StaticResource TabButtonStyle}" Height="38" Margin="0,5"/>
                                <Button x:Name="btnModeParkour" Content="PARKOUR" Click="btnModeParkour_Click" Style="{StaticResource TabButtonStyle}" Height="38" Margin="0,5"/>

                                <Rectangle Height="1" Fill="#33FFFFFF" Margin="0,10"/>
                                <Button x:Name="tgVoiceChat" Content="🎤 VOICE CHAT: OFF" Click="tgVoiceChat_Click" Style="{StaticResource TabButtonStyle}" Height="38" Margin="0,5" Background="#333333" Foreground="Gray"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="2" VerticalAlignment="Bottom" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                <TextBlock x:Name="lblLauncherVersion" Foreground="White" Opacity="0.4" FontSize="11" Margin="0,0,15,0"/>
                                <TextBlock x:Name="lblModpackVersion" Foreground="#43b581" Opacity="0.6" FontSize="11"/>
                            </StackPanel>
                            <TextBlock x:Name="lblPlayTime" Foreground="White" Opacity="0.6" FontSize="11" FontWeight="Bold"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Button Style="{StaticResource SocialButtonStyle}" Background="#000000" Click="OpenTikTok">
                                <Path Data="{StaticResource IconTikTok}" Fill="White" Width="14" Height="14" Stretch="Uniform"/>
                            </Button>
                            <Button Style="{StaticResource SocialButtonStyle}" Background="#FF0000" Click="OpenYouTube">
                                <Path Data="{StaticResource IconYouTube}" Fill="White" Width="14" Height="14" Stretch="Uniform"/>
                            </Button>
                            <Button Style="{StaticResource SocialButtonStyle}" Background="#5865F2" Click="OpenDiscord">
                                <Path Data="{StaticResource IconDiscord}" Fill="White" Width="14" Height="14" Stretch="Uniform"/>
                            </Button>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Click="btnSettings_Click" Foreground="White" Background="#22FFFFFF" Width="42" Height="42" Margin="0,0,12,0" Content="⚙"/>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock x:Name="lblProfileName" Foreground="White" FontWeight="Bold" FontSize="13" HorizontalAlignment="Right"/>
                                <TextBlock x:Name="lblAccountType" Foreground="#43b581" FontSize="10" HorizontalAlignment="Right"/>
                            </StackPanel>
                            <Border Width="60" Height="60" CornerRadius="12" BorderBrush="#43b581" BorderThickness="2">
                                <Border.Background>
                                    <ImageBrush x:Name="imgSkin" Stretch="Uniform"/>
                                </Border.Background>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>

                <Grid x:Name="pnlRegister" Visibility="Collapsed" Panel.ZIndex="600">
                    <Rectangle Fill="Black" Opacity="0.85"/>
                    <Border x:Name="brdRegister" Background="#1A1A1A" Width="450" Height="550" CornerRadius="25" BorderBrush="#43b581" BorderThickness="1.5" VerticalAlignment="Center">
                        <StackPanel Margin="30">
                            <Grid Margin="0,0,0,20">
                                <TextBlock Text="CREARE CONT NOU" Foreground="White" FontSize="22" FontWeight="Bold"/>
                                <Button Content="✕" Click="btnCloseRegister_Click" HorizontalAlignment="Right" Background="Transparent" Foreground="Gray" BorderThickness="0" FontSize="20" Cursor="Hand"/>
                            </Grid>

                            <TextBlock Text="NUME UTILIZATOR" Foreground="Gray" FontSize="10" FontWeight="Bold" Margin="0,5,0,8"/>
                            <TextBox x:Name="regUsername" Height="40" Background="#0A0A0A" Foreground="White" VerticalContentAlignment="Center" Padding="12,0" FontSize="14" BorderBrush="#333"/>

                            <TextBlock Text="PAROLĂ" Foreground="Gray" FontSize="10" FontWeight="Bold" Margin="0,15,0,8"/>
                            <PasswordBox x:Name="regPassword" Height="40" Background="#0A0A0A" Foreground="White" VerticalContentAlignment="Center" Padding="12,0" FontSize="14" BorderBrush="#333"/>

                            <TextBlock Text="DISCORD USERNAME (OPȚIONAL)" Foreground="Gray" FontSize="10" FontWeight="Bold" Margin="0,15,0,8"/>
                            <TextBox x:Name="regDiscord" Height="40" Background="#0A0A0A" Foreground="White" VerticalContentAlignment="Center" Padding="12,0" FontSize="14" BorderBrush="#333"/>

                            <TextBlock Text="COD INVITAȚIE / REFERRAL (OPȚIONAL)" Foreground="#43b581" FontSize="10" FontWeight="Bold" Margin="0,15,0,8"/>
                            <TextBox x:Name="regReferral" Height="40" Background="#0A0A0A" Foreground="#43b581" VerticalContentAlignment="Center" Padding="12,0" FontSize="14" BorderBrush="#43b581"/>

                            <Button x:Name="btnConfirmRegister" Content="CREEAZĂ CONT" Click="btnConfirmRegister_Click" Height="55" Margin="0,25,0,0" Style="{StaticResource LaunchButtonStyle}"/>
                            <TextBlock x:Name="lblRegStatus" Foreground="#43b581" HorizontalAlignment="Center" Margin="0,10,0,0" FontSize="12"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid x:Name="pnlReferralPrompt" Visibility="Collapsed" Panel.ZIndex="650">
                    <Rectangle Fill="Black" Opacity="0.90"/>
                    <Border Background="#1A1A1A" Width="400" CornerRadius="20" BorderBrush="#43b581" BorderThickness="1.5" VerticalAlignment="Center" Padding="10">
                        <StackPanel Margin="25">
                            <TextBlock Text="🎁 SISTEM DE INVITAȚII" Foreground="White" FontSize="22" FontWeight="Bold" TextAlignment="Center"/>

                            <TextBlock Text="Cine te-a adus pe server?&#x0a;Introdu ID-ul prietenului pentru a primi 1,000 Lei Bonus în joc!" 
                       Foreground="LightGray" TextWrapping="Wrap" Margin="0,15,0,20" TextAlignment="Center" FontSize="13" LineHeight="18"/>

                            <TextBox x:Name="txtReferralCode" Height="45" Margin="0,0,0,15" TextAlignment="Center" VerticalContentAlignment="Center"
                     FontSize="18" Background="#0A0A0A" Foreground="#43b581" BorderBrush="#333" FontWeight="Bold"/>

                            <Button x:Name="btnSubmitReferral" Content="TRIMITE CODUL" Style="{StaticResource LaunchButtonStyle}" 
                    Height="45" Click="btnSubmitReferral_Click" FontSize="15"/>

                            <Button x:Name="btnSkipReferral" Content="SARI PESTE (NU AM NICIUN COD)" 
                    Background="Transparent" Foreground="Gray" Height="35" Margin="0,15,0,0" 
                    Click="btnSkipReferral_Click" BorderThickness="0" Cursor="Hand" FontWeight="Bold" FontSize="11"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid x:Name="pnlSettings" Visibility="Collapsed" Panel.ZIndex="500">
                    <Rectangle Fill="Black" Opacity="0.85"/>
                    <Border Background="#1A1A1A" Width="500" Height="500" CornerRadius="25" BorderBrush="#43b581" BorderThickness="1.5" VerticalAlignment="Center">
                        <Grid>
                            <StackPanel Margin="30">
                                <Grid Margin="0,0,0,20">
                                    <TextBlock Text="SETĂRI AVANSATE" Foreground="White" FontSize="22" FontWeight="Bold"/>
                                    <Button Content="✕" Click="btnCloseSettings_Click" HorizontalAlignment="Right" Background="Transparent" Foreground="Gray" BorderThickness="0" FontSize="20" Cursor="Hand"/>
                                </Grid>

                                <TextBlock Text="ARGUMENTE JAVA (JVM)" Foreground="Gray" FontSize="11" FontWeight="Bold" Margin="0,10,0,5"/>
                                <TextBox x:Name="txtJvmArgs" Height="60" Background="#0A0A0A" Foreground="#43b581" VerticalContentAlignment="Top" Padding="10" BorderBrush="#333" Margin="0,0,0,15" TextWrapping="Wrap" AcceptsReturn="True" FontSize="11" Text="-XX:+UseG1GC -Xmx4G"/>

                                <TextBlock Text="CALE JOC" Foreground="Gray" FontSize="11" FontWeight="Bold" Margin="0,0,0,5"/>
                                <TextBox x:Name="txtGamePath" IsReadOnly="True" Height="35" Background="#0A0A0A" Foreground="Gray" VerticalContentAlignment="Center" Padding="12,0" BorderBrush="#333" Margin="0,0,0,20"/>

                                <TextBlock Text="LOGIN RAPID BROWSER" Foreground="Gray" FontSize="11" FontWeight="Bold" Margin="0,0,0,5"/>
                                <Border Background="#0A0A0A" CornerRadius="10" Padding="10" BorderBrush="#333" BorderThickness="1" Margin="0,0,0,15">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="txtWebToken" Text="********" Foreground="#43b581" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="5,0"/>
                                            <Button x:Name="btnShowWebToken" Grid.Column="1" Content="AFIȘEAZĂ COD" Padding="10,5" Click="btnShowWebToken_Click" Background="#333" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="10" FontWeight="Bold"/>
                                        </Grid>
                                        <Button Content="DESCHIDE SITE-UL ȘI LOGHEAZĂ-MĂ" Margin="0,10,0,0" Background="#43b581" Foreground="Black" FontWeight="Bold" Padding="8" Click="btnOpenWebLogin_Click" BorderThickness="0" Cursor="Hand" FontSize="10"/>
                                        <TextBlock Text="* Codul este de unică folosință și expiră la utilizare." Foreground="#555" FontSize="8" Margin="0,5,0,0" FontStyle="Italic" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <UniformGrid Columns="2" Margin="0,10">
                                    <Button Content="DECONECTARE" Click="btnLogout_Click" Background="#333" Foreground="White" Height="40" Margin="5" Style="{StaticResource LaunchButtonStyle}" FontSize="11"/>
                                    <Button Content="ȘTERGE DATE" Click="btnDeleteData_Click" Background="#E81123" Foreground="White" Height="40" Margin="5" Style="{StaticResource LaunchButtonStyle}" FontSize="11"/>
                                </UniformGrid>
                            </StackPanel>

                            <Button Width="15" Height="15" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10" Background="Transparent" BorderThickness="0" Click="btnOpenSecretBypass_Click" Cursor="Arrow"/>

                            <Border x:Name="pnlSecretBypass" Visibility="Collapsed" Background="#1A1A1A" CornerRadius="20" BorderBrush="Gold" BorderThickness="1" Margin="30" VerticalAlignment="Bottom" Padding="15">
                                <StackPanel>
                                    <TextBlock Text="MOD OWNER" Foreground="Gold" FontWeight="Bold" FontSize="10" Margin="0,0,0,5"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <PasswordBox x:Name="txtBypassPass" Height="30" Background="#000" Foreground="White" BorderBrush="#333"/>
                                        <Button x:Name="btnOwnerBypass" Content="OK" Click="btnOwnerBypass_Click" Grid.Column="1" Width="40" Margin="5,0,0,0" Background="Gold" Foreground="Black" FontWeight="Bold"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <Grid x:Name="SplashScreen" Background="#121212" Visibility="Visible" Panel.ZIndex="1000">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="EVO CRAFT" FontSize="80" FontWeight="Black" Foreground="#43b581" HorizontalAlignment="Center"/>
                        <ProgressBar x:Name="pbSplashLoading" IsIndeterminate="True" Width="250" Height="2" Background="#1AFFFFFF" Foreground="#43b581" BorderThickness="0" Margin="0,30,0,10"/>
                        <TextBlock x:Name="lblSplashLoadingText" Text="Se încarcă resursele..." Foreground="#43b581" HorizontalAlignment="Center" FontSize="14" Margin="0,10,0,0"/>

                        <Button x:Name="btnExitVps" 
                                Content="ÎNCHIDE LAUNCHER" 
                                Visibility="Collapsed" 
                                Width="300" Height="50" 
                                Margin="0,30,0,0"
                                Style="{StaticResource LaunchButtonStyle}" 
                                Background="#E81123"
                                Click="btnClose_Click"/>

                        <Button Width="40" Height="20" 
                                Background="Transparent" 
                                BorderThickness="0" 
                                Click="btnOpenSecretBypass_Click" 
                                HorizontalAlignment="Center" 
                                Margin="0,20,0,0" 
                                Cursor="Arrow" 
                                Opacity="0.05">
                            <TextBlock Text="." Foreground="#121212"/>
                        </Button>
                    </StackPanel>

                    <Border Visibility="{Binding Visibility, ElementName=pnlSecretBypass}" 
                            Background="#1A1A1A" Width="300" Height="100" CornerRadius="20" 
                            BorderBrush="Gold" BorderThickness="1" 
                            VerticalAlignment="Bottom" Margin="0,0,0,50" Padding="15">
                        <StackPanel>
                            <TextBlock Text="MOD OWNER BYPASS" Foreground="Gold" FontWeight="Bold" FontSize="10" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <PasswordBox x:Name="txtSplashBypassPass" Height="30" Background="#000" Foreground="White" BorderBrush="#333"/>
                                <Button Content="OK" Click="btnOwnerBypass_Click" Grid.Column="1" Width="40" Margin="5,0,0,0" Background="Gold" Foreground="Black" FontWeight="Bold"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>